# ---- Required: OpenRouter key (free signup at https://openrouter.ai/keys). Never commit the real .env. ----
OPENROUTER_API_KEY=

PORT=3001
NODE_ENV=development

# ---- Comma-separated origins allowed to call the API when the frontend is hosted separately. ----
ALLOWED_ORIGINS=

# ---- Barracks (subagent fleet). Optional — only needed for agents on that provider. ----
# Free key at https://aistudio.google.com — powers the Scout seed agent.
GEMINI_API_KEY=

# Where local Ollama serves models. Only needed for Ollama agents (Tinker seed).
OLLAMA_URL=http://localhost:11434

# Sandbox dir for agent file/shell tools. Agents can never touch anything outside it.
AI_ARMY_WORKDIR=

# Agentic loop guards.
MISSION_MAX_STEPS=10
MISSION_TIMEOUT_MS=600000
APPROVAL_TIMEOUT_MS=600000
